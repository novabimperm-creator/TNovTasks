<Window x:Class="TNovTasks.CommentsWindow280"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Width="760"
        Height="480"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="КОММЕНТАРИИ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="CancelButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{Binding TitleText, FallbackValue='Укажите комментарий к новой версии каждого задания'}"
                       TextWrapping="Wrap"
                       Style="{StaticResource DialogMessageStyle}"
                       Margin="0,0,0,12"/>

            <DataGrid Grid.Row="2"
                      x:Name="RowsGrid"
                      ItemsSource="{Binding Rows}"
                      Style="{StaticResource DarkDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Группа"
                                        Binding="{Binding HoleGroupName}"
                                        IsReadOnly="True"
                                        Width="*"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <!-- Комментарий обязателен: поле ввода открыто сразу, без
                         двойного клика, пустое подсвечивается при отправке. -->
                    <DataGridTemplateColumn Header="Комментарий к версии *"
                                            Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="32"
                                         Margin="0,2"
                                         TextWrapping="Wrap">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#E5534B"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Ответственный в TNovPRO: свой у каждого задания, необязателен. -->
                    <DataGridTemplateColumn x:Name="AssigneeColumn"
                                            Header="Ответственный"
                                            Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding AssigneeText}"
                                        IsEnabled="{Binding CanPickAssignee}"
                                        ToolTip="{Binding AssigneeToolTip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Click="PickAssignee_Click"
                                        Margin="0,2">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CloseButtonStyle}">
                                            <Setter Property="MinHeight" Value="32"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AssigneeId}" Value="{x:Null}">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3"
                       x:Name="ErrorText"
                       Foreground="#E5534B"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Visibility="Collapsed"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Отмена"
                        Style="{StaticResource CloseButtonStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
                <Button Grid.Column="2"
                        Content="Отправить"
                        Style="{StaticResource RunButtonStyle}"
                        Margin="0"
                        IsDefault="True"
                        Click="SubmitButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
