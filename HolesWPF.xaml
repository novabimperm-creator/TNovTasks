<Window x:Class="TNovTasks.HolesWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovTasks"
        mc:Ignorable="d"
        Width="360"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:HolesViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ОТМЕТКИ ВЫРЕЗАНИЕ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Text="Выберите сценарий работы"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,2,0,16"/>

            <ToggleButton x:Name="checkBox1"
                          Style="{StaticResource CardToggleStyle}"
                          IsChecked="{Binding pars}">
                <StackPanel>
                    <TextBlock Text="Заполнить отметки" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Заполнить параметры отметок отверстий"
                               Style="{StaticResource CardSubtitleStyle}"/>
                </StackPanel>
            </ToggleButton>

            <ToggleButton x:Name="checkBox2"
                          Style="{StaticResource CardToggleStyle}"
                          IsChecked="{Binding cut}">
                <StackPanel>
                    <TextBlock Text="Вырезать отверстия" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="Выполнить вырезание отверстий в конструкциях"
                               Style="{StaticResource CardSubtitleStyle}"/>
                </StackPanel>
            </ToggleButton>

            <TextBlock Text="Область вырезки"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="14,0,0,8"/>

            <StackPanel Margin="14,0,0,0">
                <RadioButton x:Name="rB1"
                             Style="{StaticResource CardRadioStyle}"
                             GroupName="elems"
                             IsChecked="{Binding all}">
                    <TextBlock Text="Все" Style="{StaticResource CardTitleStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rB2"
                             Style="{StaticResource CardRadioStyle}"
                             GroupName="elems"
                             IsChecked="{Binding visible}">
                    <TextBlock Text="Видимые" Style="{StaticResource CardTitleStyle}"/>
                </RadioButton>
                <RadioButton x:Name="rB3"
                             Style="{StaticResource CardRadioStyle}"
                             GroupName="elems"
                             IsChecked="{Binding selected}"
                             Margin="0,0,0,10">
                    <TextBlock Text="Выбранные" Style="{StaticResource CardTitleStyle}"/>
                </RadioButton>
            </StackPanel>

            <Button Content="Применить"
                    Style="{StaticResource RunButtonStyle}"
                    x:Name="acceptButton"
                    IsDefault="True"
                    Click="acceptButton_Click"/>
            <Button Content="Отмена"
                    Style="{StaticResource CloseButtonStyle}"
                    x:Name="escButton"
                    IsCancel="True"
                    Click="escButton_Click"/>
        </StackPanel>
    </Border>
</Window>
