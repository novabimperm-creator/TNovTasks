<Window x:Class="TNovTasks.TaskListNewWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovTasks"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Height="580"
        Width="770"
        MinWidth="770"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <Style x:Key="WrapCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DarkDataGridTextElementStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ЗАДАНИЯ ОТ ИОС"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                <TextBlock Text="Фильтрация по назначению (ADSK_Группирование):"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="TypeComboBox"
                          Width="180"
                          Style="{StaticResource DarkComboBoxStyle}"
                          Margin="0"
                          SelectionChanged="TypeComboBox_SelectionChanged"/>
            </StackPanel>

            <TextBlock x:Name="CurrentFilterText"
                       Grid.Row="2"
                       Foreground="{StaticResource MutedBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Visibility="Hidden"/>

            <DataGrid Grid.Row="3"
                      x:Name="ItemsListView"
                      Style="{StaticResource DarkDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      RowHeight="{x:Static sys:Double.NaN}"
                      MinHeight="350"
                      MaxHeight="420"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="От кого"
                                        Binding="{Binding HoleGroupNamePart1}"
                                        Width="70"
                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                    <DataGridTextColumn Header="Кому"
                                        Binding="{Binding HoleGroupNamePart2}"
                                        Width="70"
                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                    <DataGridTextColumn Header="Этаж"
                                        Binding="{Binding HoleGroupNamePart3}"
                                        Width="70"
                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                    <DataGridTextColumn Header="Версия"
                                        Binding="{Binding HoleGroupVersion}"
                                        Width="70"
                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                    <DataGridTextColumn Header="Выдано"
                                        Binding="{Binding HoleGroupDateInitiator}"
                                        Width="130"
                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding HoleGroupStatus}"
                                        Width="170"
                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                    <DataGridTemplateColumn Header="Действие" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,4"
                                        FontSize="12"
                                        MinHeight="28"
                                        Click="ItemButton_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding IsButtonVisible, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{Binding ButtonToolTip}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Button Grid.Row="4"
                    Content="Закрыть"
                    x:Name="escButton"
                    Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Stretch"
                    IsCancel="True"
                    Click="escButton_Click"/>
        </Grid>
    </Border>
</Window>
