<Window x:Class="TNovTasks.TaskDetailsWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovTasks"
        mc:Ignorable="d"
        Width="930"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="←"
                            Grid.Column="0"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="backButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock Text="ДЕТАЛЬНЫЙ АНАЛИЗ"
                               Grid.Column="1"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Text="Проверьте статусы отверстий и выберите действие:"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Вы можете отработать каждое отверстие отдельно, либо полностью перевставить группу задания."
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <Button Content="Перевставить группу полностью"
                    x:Name="replaceButton"
                    Style="{StaticResource RunButtonStyle}"
                    Click="replacegroup_Click"
                    Margin="0,0,0,12"/>

            <Border Style="{StaticResource PanelFrameStyle}"
                    Margin="0,0,0,12"
                    Padding="8">
                <ScrollViewer Name="scroll"
                              Height="350"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical"
                                Name="sp0"/>
                </ScrollViewer>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Назад"
                        x:Name="backButton"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="backButton_Click"/>
                <Button Grid.Column="2"
                        Content="Завершить"
                        x:Name="cancelButton"
                        Style="{StaticResource RunButtonStyle}"
                        Margin="0"
                        IsDefault="True"
                        Click="cancelButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
