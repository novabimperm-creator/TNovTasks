<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ProjectGuid>{69DE9821-2F13-4CE5-9F04-E249D2BCCD33}</ProjectGuid>
    <RootNamespace>TNovTasks</RootNamespace>
    <AssemblyName>TNovTasks</AssemblyName>
  </PropertyGroup>

  <!-- Revit-плагин работает только на Windows; убирает CA1416 на .NET 10. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Связь с TNovPRO (папка TasksPro): HttpClient и DPAPI. На .NET Framework
       SDK-проект эти сборки сам не подтягивает. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TNovCommon\TNovCommon.csproj" Private="false" />
  </ItemGroup>

  <!-- ===== Версионирование ===== -->
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)UpdateVersion.ps1&quot;" />
  </Target>

</Project>
