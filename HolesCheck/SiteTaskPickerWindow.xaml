<Window x:Class="TNovTasks.SiteTaskPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задания модели из TNovPRO"
        Height="600"
        Width="860"
        MinHeight="360"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HoleCheckStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PillStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <Grid Margin="20,14,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="0,0,0,14" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Что проверить" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="Bold"/>
                    <TextBlock x:Name="ModelText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="WhoPanel" CornerRadius="14" Padding="10,5" Margin="0,0,10,0"
                        Background="{StaticResource CardBrush}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="WhoText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <Border x:Name="BimBadge" CornerRadius="7" Padding="6,1" Margin="8,0,0,0"
                                Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                            <TextBlock Text="BIM" Foreground="{StaticResource DarkBrush}" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Button Grid.Column="2" Content="✕" Width="30" Height="30" VerticalAlignment="Top"
                        Style="{StaticResource CloseButtonStyleMini}" Click="Cancel_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <!-- Подсказка + фильтр -->
            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <CheckBox x:Name="OnlyIssued" DockPanel.Dock="Right" Content="только «Выдано в работу»" IsChecked="True"
                          Style="{StaticResource DarkCheckBoxStyle}" FontSize="12" Click="Filter_Click"/>
                <TextBlock x:Name="HeadText" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                           Text="Отметьте задания из журнала TNovPRO. Задание проверяется по группе модели с тем же именем."/>
            </DockPanel>

            <!-- Задания -->
            <Grid Grid.Row="2">
                <ListBox x:Name="TasksList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch" SelectionMode="Single">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="card" CornerRadius="10" Padding="14,10" Margin="0,0,0,8" Cursor="Hand"
                                    Background="{StaticResource CardBrush}" BorderThickness="1.5" BorderBrush="Transparent"
                                    MouseLeftButtonUp="Card_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding InModel}"
                                              VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                                    <Border Grid.Column="1" CornerRadius="8" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center"
                                            Background="{StaticResource BgBrush}" MinWidth="48">
                                        <TextBlock Text="{Binding NumberText}" Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Task.Name}" Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource PillStyle}" Background="{StaticResource WarnBgBrush}"
                                                Visibility="{Binding NoGroupVisibility}">
                                            <TextBlock Text="нет группы в модели" Foreground="{StaticResource WarnBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Style="{StaticResource PillStyle}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding BimBg}"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding BimPill}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding BimFg}"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                        <Border Style="{StaticResource PillStyle}" Background="{StaticResource NeutralBgBrush}">
                                            <TextBlock Text="{Binding Task.StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                    <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InModel}" Value="False">
                                    <Setter TargetName="card" Property="Opacity" Value="0.55"/>
                                    <Setter TargetName="card" Property="Cursor" Value="Arrow"/>
                                </DataTrigger>
                                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="card" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" TextAlignment="Center"
                           Text="Заданий «Выдано в работу» нет.&#x0a;Снимите фильтр или проверьте всю модель."/>
            </Grid>

            <!-- Кнопки -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="Отметить все" Style="{StaticResource GhostButtonStyle}" Click="SelectAll_Click"/>
                <Button Grid.Column="2" Content="Вся модель" Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,8,0" Click="WholeModel_Click"
                        ToolTip="Проверить все группы модели, а не только задания из журнала"/>
                <Button Grid.Column="3" x:Name="CheckButton" Content="Проверить" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False" Click="Check_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
